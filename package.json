{
  "name": "xushang",
  "version": "1.0.0-beta.1",
  "private": true,
  "description": "续上：把旧聊天整理成可追溯的决定和交接背景",
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "tsc -p tsconfig.server.json --noEmit && vite build",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "perf:20k": "tsx scripts/perf-20k.ts",
    "mock-ai": "tsx scripts/mock-ai.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "check:public": "node scripts/check-public.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.5",
    "hono": "^4.9.9",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^4.1.11"
  },
  "license": "MIT"
}
